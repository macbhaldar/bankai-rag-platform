# BankRAG configuration — copy to .env and adjust.

# ---- API server ----
BANKRAG_API_HOST=127.0.0.1
BANKRAG_API_PORT=8000
# Set to require an X-API-Key header on /api/* endpoints (leave empty to disable auth)
BANKRAG_API_KEY=

# ---- Embeddings ----
# auto | chroma_default | sentence_transformers | openai | hash
#   chroma_default      : local ONNX MiniLM-L6-v2 shipped with chromadb (default, no torch)
#   sentence_transformers: requires `pip install sentence-transformers`
#   openai              : OpenAI-compatible /embeddings endpoint (set base url + key)
#   hash                : offline deterministic hashing vectorizer (tests/CI only)
BANKRAG_EMBEDDING_PROVIDER=auto
BANKRAG_EMBEDDING_MODEL=

# ---- LLM ----
# auto | openai | ollama | extractive
#   auto       : use an OpenAI-compatible key if present, else a local Ollama if
#                reachable, else the offline extractive fallback
#   openai     : any OpenAI-compatible /chat/completions endpoint (OpenAI, Azure,
#                LM Studio, llama.cpp server, Groq, ...). Configure below.
#   ollama     : local Ollama (default http://127.0.0.1:11434, model llama3.1)
#   extractive : no generation — keyword-extractive answers with citations (offline)
BANKRAG_LLM_PROVIDER=auto
BANKRAG_LLM_MODEL=gpt-4o-mini
BANKRAG_LLM_BASE_URL=https://api.openai.com/v1
BANKRAG_LLM_API_KEY=
BANKRAG_LLM_TEMPERATURE=0.1
BANKRAG_LLM_MAX_TOKENS=700
BANKRAG_OLLAMA_URL=http://127.0.0.1:11434

# ---- Retrieval tuning ----
BANKRAG_DENSE_K=24
BANKRAG_BM25_K=24
BANKRAG_FINAL_K=8
BANKRAG_RRF_K=60
BANKRAG_USE_RERANKER=false
BANKRAG_MULTI_QUERY=false

# ---- Chunking ----
BANKRAG_CHUNK_MAX_WORDS=220
BANKRAG_CHUNK_OVERLAP_WORDS=40
BANKRAG_CHUNK_MIN_WORDS=30

# ---- Security / compliance ----
BANKRAG_MASK_PII=true

# ---- Paths (defaults resolve inside the repository) ----
# BANKRAG_CORPUS_DIR=dataset/raw_documents
# BANKRAG_QA_DIR=dataset/qa
# BANKRAG_STRUCTURED_DIR=dataset/structured
# BANKRAG_DATA_DIR=data

BANKRAG_LOG_LEVEL=INFO